<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the exact same sources as the Unity Game.Sim assembly.
       LangVersion is pinned to 9.0 because that is what Unity 6000.0 supports:
       if it builds here with a newer feature, it must still build in Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Game.Sim.Runner</RootNamespace>
    <AssemblyName>SimRunner</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Sim\**\*.cs" LinkBase="Sim" />
  </ItemGroup>
</Project>
